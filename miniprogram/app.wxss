page{background:#f5f6f3;color:#202a25;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}.page{padding:32rpx 32rpx 80rpx}.eyebrow{font-size:22rpx;color:#63756b;letter-spacing:4rpx}.title{font-size:56rpx;font-weight:650;line-height:1.25;margin:18rpx 0}.subtitle,.muted{color:#6c7b72;font-size:25rpx;line-height:1.7}.card{background:white;border:1rpx solid #e4e9e1;border-radius:24rpx;padding:30rpx;margin:22rpx 0}.item-title{font-size:31rpx;font-weight:600;line-height:1.5;word-break:break-all}.body{font-size:27rpx;line-height:1.8;white-space:pre-wrap;word-break:break-all}.badge{display:inline-block;background:#eef3eb;border-radius:8rpx;padding:6rpx 12rpx;color:#52664f;font-size:22rpx;margin:0 12rpx 12rpx 0}.danger{color:#b64f31}.row{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.tabs{display:flex;gap:8rpx;margin:28rpx 0}.tab{flex:1;text-align:center;padding:18rpx 0;background:#e9eee6;border-radius:16rpx;color:#687563}.tab.on{background:#245c40;color:white}.btn{background:#245c40;color:white;border-radius:16rpx;font-size:28rpx;margin:22rpx 0;line-height:2.8}.btn::after{border:none}.btn.secondary{background:#e9eee6;color:#284e36}.btn.danger{background:#fbece4;color:#a44828}.empty{padding:48rpx 20rpx;text-align:center;line-height:1.8;color:#6c7b72}.section{font-size:33rpx;font-weight:600;margin:36rpx 0 10rpx}.stats{display:flex;gap:12rpx}.stat{flex:1;padding:24rpx 10rpx;background:white;border-radius:20rpx;text-align:center}.number{font-size:42rpx;font-weight:650}.label{font-size:23rpx;color:#71806c;margin-top:8rpx}.field{margin:30rpx 0}.field-label{display:block;font-size:25rpx;color:#596e5e;margin-bottom:14rpx}textarea,input{width:100%;background:white;border:1rpx solid #dfe6d9;border-radius:16rpx;padding:22rpx;font-size:28rpx}textarea{height:260rpx}input{height:88rpx}.choices{display:flex;gap:14rpx}.choice{flex:1;text-align:center;border:1rpx solid #dce5d6;border-radius:14rpx;padding:18rpx}.choice.on{background:#245c40;color:white}.link{color:#245c40}.line{border-bottom:1rpx solid #e7ece3;padding:20rpx 0}.note{background:#edf1e7;padding:24rpx;border-radius:16rpx;font-size:25rpx;line-height:1.7}.compact{font-size:24rpx}.spaced{margin-top:28rpx}
